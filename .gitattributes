* text=auto
*.ps1 text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf

# Native binary project/model files. Keep .wbpj XML as ordinary text.
*.[wW][bB][pP][zZ] filter=lfs diff=lfs merge=lfs -text
*.[mM][eE][cC][hH][dD][bB] filter=lfs diff=lfs merge=lfs -text
*.[mM][eE][cC][hH][dD][aA][tT] filter=lfs diff=lfs merge=lfs -text
*.[aA][gG][dD][bB] filter=lfs diff=lfs merge=lfs -text
*.[sS][cC][dD][oO][cC] filter=lfs diff=lfs merge=lfs -text
*.[pP][mM][dD][bB] filter=lfs diff=lfs merge=lfs -text

# CAD exchange geometry for studies (large even when text).
*.[xX]_[tT] filter=lfs diff=lfs merge=lfs -text
*.[xX]_[bB] filter=lfs diff=lfs merge=lfs -text
*.[sS][tT][eE][pP] filter=lfs diff=lfs merge=lfs -text
*.[sS][tT][pP] filter=lfs diff=lfs merge=lfs -text
*.[iI][gG][sS] filter=lfs diff=lfs merge=lfs -text
*.[rR][sS][tT] filter=lfs diff=lfs merge=lfs -text
*.apdl text eol=lf
